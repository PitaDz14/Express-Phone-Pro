
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Direct check to avoid recursive rule calls
    function getRole() {
      return get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) && getRole() == 'Admin';
    }

    function isWorker() {
      return isSignedIn() && exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) && getRole() == 'Worker';
    }

    function isAuthorizedStaff() {
      return isSignedIn() && exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) && (getRole() == 'Admin' || getRole() == 'Worker');
    }

    // --- Collection Rules ---

    match /user_roles/{userId} {
      // Allow user to get their own role without triggering isAdmin recursion
      allow get: if isOwner(userId) || (isSignedIn() && exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) && getRole() == 'Admin');
      allow list: if isAdmin();
      allow create: if (isOwner(userId) && request.resource.data.userId == userId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read, write: if isAuthorizedStaff();
    }

    match /products/{productId} {
      allow read, write: if isAuthorizedStaff();
    }

    match /customers/{customerId} {
      allow read, write: if isAuthorizedStaff();
    }

    match /invoices/{invoiceId} {
      allow read: if isAuthorizedStaff();
      allow create: if isAuthorizedStaff() && request.resource.data.generatedByUserId == request.auth.uid;
      allow update, delete: if isAdmin() || (resource != null && resource.data.generatedByUserId == request.auth.uid);

      match /items/{invoiceItemId} {
        allow read: if isAuthorizedStaff();
        allow create: if isAuthorizedStaff();
        allow update, delete: if isAdmin() || (resource != null && resource.data.generatedByUserId == request.auth.uid);
      }
      
      match /payments/{paymentId} {
        allow read: if isAuthorizedStaff();
        allow create, update, delete: if isAuthorizedStaff();
      }
    }

    match /repairs/{repairId} {
      allow read, write: if isAuthorizedStaff();
    }

    match /audit_logs/{auditLogId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
